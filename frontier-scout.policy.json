{
  "version": 1,
  "allowed_tools": [],
  "blocked_tools": [],
  "allowed_shell_commands": [
    "ls",
    "cat",
    "git status",
    "git diff",
    "git log",
    "git add",
    "git commit",
    "git checkout",
    "git switch",
    "git branch",
    "git fetch",
    "git pull",
    "git push",
    "git stash",
    "git restore",
    "git rebase",
    "git merge",
    "grep",
    "find",
    "pytest",
    "ruff",
    "mypy",
    "black",
    "make",
    "coverage",
    "bandit",
    "detect-secrets",
    "pip install -e",
    "python -m",
    "python3 -m",
    "gh pr",
    "gh run",
    "gh api"
  ],
  "blocked_shell_commands": [
    "rm -rf",
    "sudo",
    "chmod 777",
    "git push --force",
    "git push -f",
    "curl | sh",
    "curl | bash",
    "wget | sh",
    "mkfs",
    "dd if=",
    "> /dev/sda",
    ":(){"
  ],
  "allowed_file_globs": [
    "frontier_scout/**",
    "tests/**",
    "examples/**",
    "docs/**",
    "**/*.md",
    "*.toml",
    "*.cfg",
    "*.ini",
    "*.txt",
    "Makefile",
    "requirements.txt"
  ],
  "protected_file_globs": [
    ".github/workflows/**",
    "**/.env",
    "**/.env.*",
    "**/*.pem",
    "**/*.key",
    "**/secrets/**",
    "frontier-scout.policy.json",
    "policy.lock.json",
    ".claude/hooks/**",
    ".claude/settings.json"
  ],
  "mcp_server_allowlist": [
    "gitnexus"
  ],
  "required_checks": [
    "pytest",
    "ruff check .",
    "mypy"
  ],
  "approval_gates": [
    "network",
    "shell",
    "credential",
    "write",
    "protected-path",
    "ci"
  ],
  "policy_notes": "Dogfood policy for the Frontier Scout repo itself. Allows the normal dev surface (frontier_scout/tests/docs/examples edits; pytest/ruff/mypy/make/git/gh) and the gitnexus MCP server. Protects CI config, secrets, and \u2014 notably \u2014 the policy, lock, and hooks themselves, so an agent can't silently weaken its own guardrails without an approval-gated, receipted action.",
  "decision_model": {
    "provider": "typesafe",
    "model": "jev-1.13.0",
    "base_url": "https://api.typesafe.ai",
    "key_env": "TYPESAFE_API_KEY",
    "timeout_seconds": 3.0,
    "relax_ask_to_allow_at": 0.95,
    "deny_at": 0.9,
    "ask_at": 0.5,
    "scope": [
      "Bash"
    ]
  }
}
