{
  "version": 1,
  "allowed_tools": [],
  "blocked_tools": [],
  "allowed_shell_commands": [
    "ls",
    "cat",
    "git status",
    "git diff",
    "pytest",
    "ruff"
  ],
  "blocked_shell_commands": [
    "rm -rf",
    "sudo",
    "git push --force",
    "curl | sh",
    "curl | bash"
  ],
  "allowed_file_globs": [
    "src/**",
    "tests/**",
    "**/*.md"
  ],
  "protected_file_globs": [
    "**/.env",
    "**/.env.*",
    "**/migrations/**",
    ".github/workflows/**",
    "infra/**",
    "**/Dockerfile"
  ],
  "mcp_server_allowlist": [
    "github"
  ],
  "required_checks": [
    "pytest"
  ],
  "approval_gates": [
    "network",
    "shell",
    "credential",
    "write",
    "protected-path"
  ],
  "policy_notes": "Sample policy for the Frontier Scout compile -> receipts -> verify-pr demo."
}
