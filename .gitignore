# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Frontier Scout runtime state lives in ~/.frontier-scout/ on the user's
# laptop. The repo should never contain a scan database or cost ledger.
*.db
*.db-journal
*.db-wal
*.db-shm
costs.jsonl
quality-log.jsonl

# In-repo Frontier Scout runtime state (agent-firewall receipts, profile.json,
# policy.toml). The intentional, committable agent policy is
# `frontier-scout.policy.json` at the repo root — keep that tracked.
.frontier-scout/
signals-log.jsonl

# Lab subprocess scratch workspaces (created under /tmp, but symlinks
# happen during local debugging).
ai-lab-experiments/
.scratch/

# Local screenshots / debugging artifacts (operator-only).
screenshots/
screenshots_*/
