/* Mission Control (tui3) theme — exact design palette mapped to Textual CSS.
   Layout is breakpoint-driven: the app sets a class on Screen
   (-tiny / -micro / -narrow / -mid / -wide) from on_resize, and these rules
   reflow rail<->tabstrip and show/hide chrome. Colors mirror the design CSS. */

Screen {
  background: #0b1117;
  color: #a9bccd;
  layout: vertical;
}

/* ── Header ─────────────────────────────────────────────────────────────── */
#mc-header {
  height: 1;
  background: #0d1622;
  color: #a9bccd;
  padding: 0 1;
}
#mc-header .mark { color: #24d6a8; }
#mc-header .name { color: #d9f7ff; text-style: bold; }
#mc-header .sep { color: #25405c; }
#mc-header .repo { color: #a9bccd; }
#mc-header .prov { color: #6e8aa1; }
#mc-header .hdr-right { color: #6e8aa1; }
#mc-header .bell { color: #24d6a8; }

/* ── Body: rail + main (wide/mid) or tabstrip + main (narrow/micro) ──────── */
#mc-body { height: 1fr; }
#mc-body.row { layout: horizontal; }
#mc-body.col { layout: vertical; }

#mc-rail {
  width: 24;
  background: #0d1622;
  border-right: tall #152232;
  padding: 1 0;
}
#mc-rail.compact { width: 8; }
.rail-brand { color: #24d6a8; text-style: bold; padding: 0 1 1 1; }
.rtab { padding: 0 1; color: #a9bccd; height: 1; }
.rtab.on { background: #10202a; color: #d9f7ff; text-style: bold; }
.rtab .key { color: #6e8aa1; }
.rtab.on .key { color: #24d6a8; }
.rtab .badge { color: #6e8aa1; }
.rtab.on .badge { color: #24d6a8; }

#mc-tabstrip {
  height: 1;
  background: #0d1622;
  border-bottom: tall #152232;
  padding: 0 1;
}
#mc-tabstrip .ts { color: #6e8aa1; padding: 0 1; }
#mc-tabstrip .ts.on { color: #24d6a8; text-style: bold; }

#mc-main { width: 1fr; height: 1fr; padding: 1 2; overflow-y: auto; }
#mc-main.full { padding: 1 1; }

/* ── Compass (footer) ───────────────────────────────────────────────────── */
#mc-compass {
  height: 1;
  background: #0d1622;
  color: #6e8aa1;
  padding: 0 1;
}
#mc-compass .key { color: #24d6a8; text-style: bold; }
#mc-compass .tail { color: #6e8aa1; }
#mc-compass .ok { color: #24d6a8; }

/* ── Floor (resize to continue) ─────────────────────────────────────────── */
#mc-floor { align: center middle; height: 1fr; }
#mc-floor .floor-icon { color: #e3c26f; text-align: center; }
#mc-floor .floor-title { color: #d9f7ff; text-style: bold; text-align: center; }
#mc-floor .floor-body { color: #6e8aa1; text-align: center; }
#mc-floor .ok { color: #24d6a8; }
#mc-floor .bad { color: #ff6b6b; }

/* ── Shared panel / primitive tones ─────────────────────────────────────── */
.panel { border: round #1a2c41; padding: 0 1; }
.panel-title { color: #24d6a8; text-style: bold; }
.panel-sub { color: #6e8aa1; }

.tone-mint { color: #24d6a8; }
.tone-gold { color: #e3c26f; }
.tone-blue { color: #7aa6ff; }
.tone-red { color: #ff6b6b; }
.tone-muted { color: #6e8aa1; }
.bright { color: #d9f7ff; text-style: bold; }
.dim { color: #6e8aa1; }

/* verdict tags */
.vtag-adopt { color: #06231b; background: #24d6a8; text-style: bold; }
.vtag-trial { color: #2b2208; background: #e3c26f; text-style: bold; }
.vtag-assess { color: #091a36; background: #7aa6ff; text-style: bold; }
.vtag-hold { color: #ffffff; background: #ff6b6b; text-style: bold; }

/* severity chips */
.sev-high { color: #ff6b6b; }
.sev-medium { color: #e3c26f; }
.sev-low { color: #6e8aa1; }

/* selection row */
.row-sel { background: #10202a; }

/* buttons / chips */
.chip { color: #a9bccd; }
.chip.on { color: #24d6a8; text-style: bold; }

/* ── Scout tab ──────────────────────────────────────────────────────────── */
.scout-root { height: auto; }
.scout-hero { height: auto; margin-bottom: 1; }
.scout-scanbar { height: auto; margin-bottom: 1; }
.scout-empty { height: auto; }
.scout-split { layout: horizontal; height: auto; }
.scout-list { height: auto; }
.scout-list.side { width: 44%; padding-right: 1; }
.scout-detail { height: auto; }
.scout-detail.side { width: 1fr; border-left: tall #152232; padding-left: 1; }
.scout-ask { height: auto; margin-top: 1; }

/* Adoption Matrix (wide) + Tier Ledger (mid/narrow) — v5 signature instrument.
   Cells are equal 1fr columns after a fixed axis gutter, so the header labels
   and every cell row line up (the prototype's grid-template-columns: 3×1fr). */
.scout-matrix { height: auto; margin-bottom: 1; }
.scout-matrix-row { layout: horizontal; height: auto; }
.scout-matrix-axis { width: 7; height: auto; }
.scout-matrix-cell { width: 1fr; height: auto; }
.scout-matrix-read { height: auto; margin-top: 1; }
.scout-ledger { height: auto; margin-bottom: 1; }
.scout-ledger-row { layout: horizontal; height: auto; }
